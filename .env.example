# ── Server ────────────────────────────────────────────────
PORT=3000
HOST=0.0.0.0

# ── Datenbank ─────────────────────────────────────────────
DB_PATH=./data/tender-crawler.sqlite

# ── Crawling ──────────────────────────────────────────────
# Cron-Ausdruck für den regelmäßigen Crawl (Standard: alle 8 Stunden)
CRAWL_CRON=0 */8 * * *
# Crawl direkt beim Serverstart ausführen
CRAWL_ON_START=true

# Respektvoller User-Agent für die Portal-Anfragen
USER_AGENT=TenderCrawler/1.0 (+Forschungseinrichtung; durchsucht öffentliche Vergabebekanntmachungen)

# Request-Verhalten
REQUEST_TIMEOUT_MS=30000
REQUEST_DELAY_MS=1200
MAX_REQUESTS_PER_MINUTE=40
MAX_RESULTS_PER_PORTAL=250

# TED-API: wie viele Tage zurück gesucht wird
TED_DAYS_BACK=3

# ── LLM-Anreicherung ─────────────────────────────────────
# Aktivieren nur, wenn ein LLM verfügbar ist
LLM_ENABLED=false
# Provider: ollama | openai | custom
LLM_PROVIDER=ollama
# Ollama (lokal)
LLM_OLLAMA_URL=http://localhost:11434
LLM_OLLAMA_MODEL=llama3.1:8b
# OpenAI-kompatibel (auch vLLM, LM Studio usw.)
LLM_OPENAI_API_KEY=
LLM_OPENAI_MODEL=gpt-4o-mini
LLM_OPENAI_BASE_URL=https://api.openai.com/v1

# Tageslimit für Analysen und Batch-Größe
LLM_MAX_ANALYSES_PER_DAY=50
LLM_BATCH_SIZE=5

# Forschungsprofil, an dem die Relevanz gemessen wird
LLM_RESEARCH_PROFILE=Forschungseinrichtung mit Kernkompetenzen in angewandter Forschung. Interessiert an Ausschreibungen für Forschungsprojekte, Technologieentwicklung, Beratungsleistungen, IT- und Laborausstattung sowie wissenschaftliche Dienstleistungen.

# Minimaler Relevanz-Score für Benachrichtigungen (0.0 – 1.0)
LLM_MIN_RELEVANCE_THRESHOLD=0.4

# ── Auth (Token) ──────────────────────────────────────────
# Set AUTH_ENABLED=true und vergebe einen starken Token
AUTH_ENABLED=true
AUTH_TOKEN=bitte-aendern-mich

# ── Deployment ────────────────────────────────────────────
TRUST_PROXY=false

# ── Logging ───────────────────────────────────────────────
# pino-Level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ── Browser-Worker (Playwright) ────────────────────────────
# eVergabe (Wicket-JS-Plattform) wird über einen Browser-Worker
# mit einem Headless-Chromium vollständig paginiert. Beim normalen
# Serverstart wird der Worker automatisch mitgestartet.
BROWSER_WORKER_ENABLED=true
BROWSER_HEADLESS=true
BROWSER_PROFILE_DIR=./data/browser-profiles
# Job-Timeout, Seitenwartezeit und max. gleichzeitige Tabs
BROWSER_JOB_TIMEOUT_MS=1800000
BROWSER_PAGE_WAIT_MS=2500
BROWSER_MAX_TABS=2

# Backfill-Zeitraum für den automatischen Initialimport
EVERGABE_BACKFILL_MONTHS=24
# Stopp nach N vollständig bekannten Seiten im inkrementellen Modus
EVERGABE_KNOWN_PAGE_STOP=3

# Worker-Laufverhalten
WORKER_POLL_INTERVAL_MS=2000
WORKER_HEARTBEAT_MS=10000
WORKER_MAX_ATTEMPTS=3
WORKER_STALE_AFTER_MS=60000

# ── Förderprogramme ─────────────────────────────────────────
# Eigener Anwendungsbereich für Förderbekanntmachungen.
FUNDING_ENABLED=true
# Cron für den regelmäßigen Förder-Crawl (Standard: täglich 06:30)
FUNDING_CRAWL_CRON=30 6 * * *
# Förder-Crawl direkt beim Serverstart ausführen
FUNDING_CRAWL_ON_START=false
# Respektvolles Verhalten der Förderquellen
FUNDING_REQUEST_DELAY_MS=1500
FUNDING_MAX_REQUESTS_PER_MINUTE=15
# LLM für die Förder-Extraktion (Standard: wie LLM_ENABLED)
FUNDING_LLM_ENABLED=false
FUNDING_RETRY_MAX=2

# ── Verwaltete Quellen (crawl_sources) ──────────────────────
# Katalog mit Förder-/Ausschreibungsquellen aktivieren
CRAWL_SOURCES_ENABLED=true
# Ungeprüfte Quellen direkt beim Serverstart proben
CRAWL_SOURCES_PROBE_ON_START=false
# Cron für den automatischen Quellen-Probe-Crawl
CRAWL_SOURCES_PROBE_CRON=0 5 * * *
# Obergrenze http-Quellen pro Crawl-Lauf
DISCOVERY_MAX_HTTP_SOURCES_PER_CRAWL=8
# User-Agent für Discovery-HTTP-Requests
DISCOVERY_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0 Safari/537.36
