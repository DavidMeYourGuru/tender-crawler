{
  "name": "tender-crawler",
  "version": "1.0.0",
  "private": true,
  "description": "Crawler für deutsche und europäische Ausschreibungsportale mit LLM-Analyse und Dashboard",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "crawl": "node src/cli-crawl.js",
    "backfill:details": "node src/cli-backfill-details.js",
    "worker": "node src/worker.js",
    "worker:dev": "node --watch src/worker.js",
    "funding": "node src/cli-fetch-funding.js",
    "probe": "node src/cli-probe-sources.js",
    "rag:backfill": "node -e \"import('./src/db.js').then(m => { const n = m.backfillSearchText(); console.log('Backfill aktualisiert:', n); })\"",
    "install:browsers": "playwright install chromium",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/static": "^8.0.0",
    "axios": "^1.7.9",
    "better-sqlite3": "^11.7.0",
    "cheerio": "^1.0.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.0",
    "node-cron": "^3.0.3",
    "pdf-parse": "^2.4.5",
    "playwright": "^1.62.1"
  }
}
